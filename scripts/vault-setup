#!/bin/bash

set -euo pipefail

EXTERNAL_IP="${EXTERNAL_IP:-localhost}"
export VAULT_ADDR="http://${EXTERNAL_IP}:30820"

echo "Logging into Vault as root ..."
export VAULT_TOKEN
VAULT_TOKEN="$(kubectl --context=rancher-desktop get secret vault-secret -o jsonpath='{.data.ROOT_TOKEN}' | base64 -d)"

# Reset: disable everything this script owns, so every run starts from a
# clean slate, as if it were the first run.
#
echo "Resetting transit secrets engine ..."
vault secrets disable transit >/dev/null 2>&1 || true

echo "Resetting KV secrets engine ..."
vault secrets disable secret >/dev/null 2>&1 || true

echo "Resetting userpass auth method ..."
vault auth disable userpass >/dev/null 2>&1 || true

echo "Resetting identity entities ..."
for id in $(vault list -format=json identity/entity/id 2>/dev/null | jq -r '.[]'); do
  vault delete "identity/entity/id/${id}" >/dev/null 2>&1 || true
done

# Transit (issuer signing key)
#
echo "Enabling transit secrets engine ..."
vault secrets enable transit >/dev/null

echo "Creating issuer signing key 'oid4vc-issuer' ..."
vault write -f transit/keys/oid4vc-issuer type=ecdsa-p256 >/dev/null

# KV v2 (subject claims)
#
echo "Enabling KV v2 secrets engine ..."
vault secrets enable -path=secret -version=2 kv >/dev/null

# Userpass (subject login)
#
echo "Enabling userpass auth method ..."
vault auth enable userpass >/dev/null

USERPASS_ACCESSOR="$(vault auth list -format=json | jq -r '."userpass/".accessor')"

# Policy granting each subject read-only access to their own claims, keyed by
# their own Identity entity name — one shared, templated policy for all subjects.
#
echo "Writing policy 'subject-self' ..."
vault policy write subject-self - >/dev/null <<'EOF'
path "secret/data/subjects/{{identity.entity.name}}" {
  capabilities = ["read"]
}
EOF

create_subject() {
  local username="$1"
  local first_name="$2"
  local family_name="$3"
  local email="$4"

  echo "Creating user '${username}' ..."
  vault write "auth/userpass/users/${username}" password="password" token_policies="subject-self" >/dev/null

  echo "Creating identity entity '${username}' ..."
  local entity_id
  entity_id="$(vault write -field=id -f identity/entity name="${username}")"

  echo "Creating identity alias for '${username}' ..."
  vault write -f identity/entity-alias \
    name="${username}" \
    canonical_id="${entity_id}" \
    mount_accessor="${USERPASS_ACCESSOR}" >/dev/null

  echo "Writing claims for '${username}' ..."
  vault kv put "secret/subjects/${username}" \
    firstName="${first_name}" \
    familyName="${family_name}" \
    email="${email}" \
    id="${username}" >/dev/null
}

# Demo subject, matching the sibling nessus-oid4vc project's "alice" persona
#
create_subject "alice" "Alice" "Wonderland" "alice@email.com"

# Demonstrate: alice logs in with her own credentials and reads her own
# claims — no root token involved.
#
echo
echo "Logging in as 'alice' ..."
ALICE_TOKEN="$(vault login -method=userpass -token-only username=alice password=password)"

echo "Fetching alice's own claims ..."
VAULT_TOKEN="${ALICE_TOKEN}" vault kv get secret/subjects/alice

echo
echo "Vault setup complete"
